{
  "uid": "cal_tipline_hubspot_app",
  "type": "app",
  "config": {
    "description": "Lets Tipline Scheduling (Cal.diy at cal.tipline.ai) find or create the guest as a contact and log each booking in HubSpot.",
    "name": "Tipline Scheduling",
    "distribution": "private",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://cal.tipline.ai/api/integrations/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.owners.read"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    }
  }
}
